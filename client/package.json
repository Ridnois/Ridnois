{
  "name": "client",
  "version": "1.0.0",
  "main": "src/main.module.ts",
  "license": "MIT",
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c --environment PRODUCTION",
    "lint": "tslint -c tslint.json 'src/**/*.ts'",
